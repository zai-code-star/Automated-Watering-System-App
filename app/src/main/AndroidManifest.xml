<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.aws">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/img_splash"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logoaws"
        android:supportsRtl="true"
        android:theme="@style/Theme.AWS"
        tools:targetApi="31">
        <activity
            android:name=".menu.ResetPasswordActivity"
            android:exported="false" />
        <activity
            android:name=".menu.ReportSystemPage"
            android:exported="false" />
        <activity
            android:name=".menu.HistoryPage"
            android:exported="false" />
        <activity
            android:name=".menu.admin.EditDeleteUserActivity"
            android:exported="false" />
        <activity
            android:name=".menu.admin.AddUserActivity"
            android:exported="false" />

        <activity
            android:name=".menu.AccountPage"
            android:exported="false" />
        <activity
            android:name=".menu.NotificationsPage"
            android:exported="false" />
        <activity
            android:name=".menu.SchedulingPage"
            android:exported="false" />
        <activity
            android:name=".menu.SensorMonitoringPage"
            android:exported="false" />
        <activity
            android:name=".menu.ZonesPage"
            android:exported="false" />
        <activity
            android:name=".menu.SettingPage"
            android:exported="false" />
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".LoginActivity"
            android:exported="false" />
        <activity
            android:name=".SplashScreen"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <service
            android:name=".ForegroundFirebaseService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

    </application>

</manifest>